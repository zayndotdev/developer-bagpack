# ==============================================================================
# DEVELOPER BACKPACK - AUTHENTICATION & AUTHORIZATION BACKEND (.env.example)
# ==============================================================================
# This file serves as the configuration template for the authentication service.
# Copy this file to '.env' before starting the server.
# Every variable below is strictly validated on server startup in 'src/config/env.js'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV: Application environment mode ('development', 'production', 'test')
# In 'development', cookies can be sent without HTTPS; in 'production', secure cookies are enforced.
NODE_ENV=development

# PORT: The network port that the Express HTTP server will listen on.
PORT=5001

# CLIENT_URL: The URL of the frontend React application for Cross-Origin Resource Sharing (CORS).
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MONGODB_URI: Standard connection string to MongoDB (local or Atlas cluster).
# Example local: mongodb://localhost:27017/developer_backpack_auth
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/developer_backpack_auth?retryWrites=true&w=majority
# Note: If no local MongoDB server is detected in development, an in-memory MongoDB fallback can be enabled.
MONGODB_URI=mongodb://localhost:27017/developer_backpack_auth

# ------------------------------------------------------------------------------
# 3. JSON WEB TOKEN (JWT) SECRETS & EXPIRATION
# ------------------------------------------------------------------------------
# JWT_ACCESS_SECRET: Cryptographic secret key used to sign and verify short-lived access tokens.
# Must be a high-entropy string (minimum 32 characters, recommended 64-byte hex or random string).
# Generate via terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=backpack_super_secret_access_jwt_key_development_only_min_32_chars!

# JWT_ACCESS_EXPIRES_IN: Lifespan of the Access Token before the client must silently refresh it.
# Recommended: 15m (15 minutes). Short-lived tokens minimize the window of opportunity if intercepted.
JWT_ACCESS_EXPIRES_IN=15m

# JWT_MFA_SECRET: Secret used to sign temporary MFA tickets issued after successful password check.
# The user exchanges this ticket along with their 2FA OTP code to receive final tokens.
JWT_MFA_SECRET=backpack_super_secret_mfa_ticket_key_development_only_min_32_chars!

# JWT_MFA_EXPIRES_IN: Lifespan of the temporary MFA ticket (recommended 5 minutes).
JWT_MFA_EXPIRES_IN=5m

# REFRESH_TOKEN_DAYS: Number of days before a persistent Refresh Token expires in the database.
# Default: 7 days.
REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# 4. ENCRYPTION KEYS (AES-256-GCM)
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY: Exactly 32 bytes (64 hexadecimal characters) used to encrypt sensitive
# data at rest in MongoDB, specifically TOTP (Google Authenticator) shared secrets.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. SMTP / EMAIL CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
# SMTP configuration used to deliver account verification emails, password resets,
# and email-based 2FA one-time passwords (OTP).
# If left blank in development, the system automatically falls back to an Ethereal test account
# and prints live preview links in the terminal console!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Developer Backpack <no-reply@developerbackpack.dev>"

# ------------------------------------------------------------------------------
# 6. SOCIAL AUTHENTICATION (Google & GitHub OAuth 2.0)
# ------------------------------------------------------------------------------
# Optional: Enables Clerk-style single-click social sign-in and sign-up.
# If left blank, the app runs smoothly with Email/Password authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
