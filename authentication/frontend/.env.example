# ==============================================================================
# DEVELOPER BACKPACK - AUTHENTICATION & AUTHORIZATION FRONTEND (.env.example)
# ==============================================================================
# This file contains the environment configuration for the React client.
# In Vite, variables exposed to the client-side bundle MUST start with 'VITE_'.
# ==============================================================================

# VITE_API_BASE_URL: The root URL for the backend Express API.
# Used by the Axios HTTP client configured in 'src/api/client.js'.
VITE_API_BASE_URL=http://localhost:5001/api/v1

# VITE_APP_NAME: Display title used in the navigation bar, document title, and cards.
VITE_APP_NAME="Developer Backpack"
